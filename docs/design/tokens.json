{
  "_about": "Design tokens for QMuraajah. Brand pass (Nov 2026): off-white canvas, white cards, forest-green pill buttons, and an earthy set (sand, stone, slate, sage, wheat, clay, moss, mist) for colour-blocked cards. Text on a tone is always ink, in both themes. Light roles at the top level, dark roles under color.dark. Names stay, values change. Run: node docs/design/build-tokens.mjs",
  "_measured": {
    "greys": "original uses 9 steps of one neutral ramp (#0a0a0a to #fafafa); we keep 6 per mode",
    "accent": "original: saturated blue for primary buttons and the goal title (role: accent)",
    "highlight": "original: amber for the streak pill, active tab text, goal-reached icon (role: highlight)",
    "quality": "original: emerald fill = Good, amber outline = Average, red outline = Needs Work",
    "fonts": "original: geometric grotesk display (headings, 900 weight), humanist sans body, system mono for IDs and numbers",
    "smallest text": "original goes down to 9-10px for labels and badges; this system floors at 12px",
    "radius": "6 badges, 12 buttons and quarter tiles, 16 inner cards and tabs track, 24 outer panels, pill for chips",
    "layout": "single centred column about 400px wide at every breakpoint; header overflows at 375px"
  },
